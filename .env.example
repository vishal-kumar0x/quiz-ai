# Google Gemini AI Config
# NEVER commit your actual API key to GitHub! Create a .env file locally and place it there.
GEMINI_API_KEY=your_gemini_api_key_here

# Runtime Configurations
PORT=8081
ALLOWED_ORIGIN=https://my-quiz-app.com

# Authentication & Admin
# If SMTP_USER is blank, the 6-Digit code will print right into your Server Terminal!
SMTP_USER=
SMTP_PASS=
# Enter your exact Email address below to be granted Admin privileges.
ADMIN_EMAIL=admin@example.com
